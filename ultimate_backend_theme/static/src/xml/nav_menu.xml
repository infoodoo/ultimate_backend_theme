<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ultimate_backend_theme.orderline_inherit" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
           <xpath expr="//Dropdown" position="replace">
              <Dropdown hotkey="'h'" title="'Home Menu'" class="'o_navbar_apps_menu'">
                  <t t-set-slot="toggler">
                    <i class="oi oi-apps" />
                  </t>
                  <DropdownItem
                    t-foreach="apps"
                    t-as="app"
                    t-key="app.id"
                    class="{ 'o_app': true, focus: menuService.getCurrentApp() === app }"
                    href="getMenuItemHref(app)"
                    dataset="{ menuXmlid: app.xmlid, section: app.id }"
                    onSelected="() => this.onNavBarDropdownItemSelection(app)"
                  />
<!--                    <div class="o_app_icon_box">-->
<!--                        <t t-if="app.web_icon_data">-->
<!--                            <img t-att-src="'data:image/png;base64,' + app.web_icon_data" class="o_app_real_icon"/>-->
<!--                        </t>-->
<!--                        <t t-if="not app.web_icon_data">-->
<!--                            <i class="fa fa-th-large"></i>-->
<!--                        </t>-->
<!--                    </div>-->
<!--                    <span class="o_app_name" t-esc="app.name"/>-->
                </Dropdown>
            </xpath>
    </t>
</templates>